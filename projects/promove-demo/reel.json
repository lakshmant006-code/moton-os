  "vo": "vo.wav",
  "voVol": 1.0,
  "voice": {
   "provider": "ElevenLabs",
   "voice": "Justin Case - Warm, Trustworthy, Clear",
   "voice_id": "DtQLDxHbTiQTpVVanTy1",
   "model": "eleven_v4",
   "source": "assets/vo/take1.mp3",
   "note": "Main take cut per line from Scribe word timings; re-recorded lines: S3 and S4 (assets/vo/addon-take1.mp3, add-on wording) and S13 (assets/vo/tagline-take1.mp3, tagline). Placed per scene by sfx/make_vo.py."
  },
  "voLines": [
   {
    "scene": "S0",
    "from": 0.0,
    "to": 2.16,
    "at": 1.0,
    "text": "Pro Move. By Procreate."
   },
   {
    "scene": "S1",
    "from": 2.48,
    "to": 4.96,
    "at": 4.05,
    "text": "What if your drawing could move the moment you do?"
   },
   {
    "scene": "S2",
    "from": 5.44,
    "to": 12.4,
    "at": 8.25,
    "text": "Today, animating a character means redrawing it, frame after frame. Twenty-four drawings, for one second."
   },
   {
    "scene": "S3",
    "from": 0.0,
    "to": 9.17,
    "at": 16.25,
    "text": "With Pro Move, an add-on for Procreate, you perform, and your character copies you. Body and face are tracked right on your iPad. Nothing goes to the cloud.",
    "src": "assets/vo/addon-take1.mp3"
   },
   {
    "scene": "S4",
    "from": 9.55,
    "to": 15.82,
    "at": 26.65,
    "text": "It installs right into Procreate, as one extra tab in Actions. Everything else stays just the way you know it.",
    "src": "assets/vo/addon-take1.mp3"
   },
   {
    "scene": "S5",
    "from": 26.32,
    "to": 29.64,
    "at": 34.05,
    "text": "Tap the camera, and your character follows you, live."
   },
   {
    "scene": "S6",
    "from": 29.84,
    "to": 33.68,
    "at": 39.55,
    "text": "Capture a single pose, or record up to ten seconds of motion."
   },
   {
    "scene": "S7",
    "from": 33.92,
    "to": 37.12,
    "at": 44.2,
    "text": "Strike a pose. Three, two, one."
   },
   {
    "scene": "S8",
    "from": 37.52,
    "to": 41.2,
    "at": 49.55,
    "text": "Every take lands in the filmstrip, ready to reorder and play back."
   },
   {
    "scene": "S9",
    "from": 41.6,
    "to": 46.56,
    "at": 55.55,
    "text": "Tap any limb to turn it, or stretch it. On one drawing, or across the whole take."
   },
   {
    "scene": "S10",
    "from": 46.96,
    "to": 50.96,
    "at": 62.05,
    "text": "Then pick how it feels. Snappy, smooth, or floaty."
   },
   {
    "scene": "S11",
    "from": 51.36,
    "to": 56.68,
    "at": 67.35,
    "text": "A quick rig check finds where the drawing tears, and local AI patches just those spots."
   },
   {
    "scene": "S12",
    "from": 56.88,
    "to": 60.76,
    "at": 73.75,
    "text": "Export your frames back to Procreate, or to your favorite motion tools."
   },
   {
    "scene": "S13",
    "from": 0.0,
    "to": 2.79,
    "at": 78.95,
    "text": "Pro Move. Imagination in motion.",
    "src": "assets/vo/tagline-take1.mp3"
   }
  ],
  "duck": {
   "under_vo": 0.45,
   "ramp": 0.3,
   "note": "music.wav is ducked under each narration line by sfx/make_music.py"
  }
 },
